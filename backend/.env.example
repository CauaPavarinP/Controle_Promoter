# Copie para .env e preencha. O .env NÃO vai para o GitHub.
APP_USUARIO=
APP_SENHA=
# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Vazio = SQLite local (backend/dados/app.db). No Render: URL do Postgres.
DATABASE_URL=
# Em produção: producao (ativa cookie seguro e esconde /docs)
AMBIENTE=
# Tamanho máximo do arquivo de faturamento em MB. Vazio ou 0 = sem limite (padrão): o arquivo é lido e gravado em
# partes, com memória constante (~330 MB de pico com 300 MB ou 650 MB de arquivo). Só defina se quiser um teto.
LIMITE_FATURAMENTO_MB=
